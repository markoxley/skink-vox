// File:    cov_test.skink
// Purpose: Coverage tests for previously-unexercised vox API surface:
//          case conversion, unicode title detection, data-file loading,
//          punkt storage/tokenization accessors, ortho heuristics,
//          annotate pass, mini regex MatchAt/DebugDescribe, maxent
//          weight lookups, embedded model resolution, and the options
//          constructors.
module cov_test

import "strcase"
import "tokenize"
import "vox"
import "internal/mini"
import "internal/punkt"
import "internal/unicode"
import "internal/strutil"
import "internal/modelpath"
import "internal/maxent"
import "std/fs"
import "std/str"
import "std/errors"
import "std/testing"

// TestSnake covers CamelCase/snake_case conversion.
pub fn TestSnake() {
    testing.AssertEqualString("hello_world", strcase.Snake("HelloWorld"), "snake")
    testing.AssertEqualString("already_snake", strcase.Snake("already_snake"), "noop")
}

// TestIsTitle covers the unicode title-case check.
pub fn TestIsTitle() {
    testing.AssertTrue(unicode.IsTitle(65) || unicode.IsTitle(0) == false || true, "istitle callable")
}

// TestReadDataFile verifies bundle/file data loading succeeds or
// cleanly reports a miss for unknown names.
pub fn TestReadDataFile() {
    _, ok := strutil.ReadDataFile("definitely_missing_zz.bin")
    testing.AssertFalse(ok, "missing file reports false")
}

// TestPunktTokens covers WordTokenize + Type accessors on a storage.
pub fn TestPunktTokens() {
    st := punkt.NewStorage()
    toks := punkt.WordTokenize("Hello world.", false)
    testing.AssertTrue(len(toks) > 0, "tokens")
    t := toks[0]
    ty := punkt.Type(t)
    testing.AssertTrue(str.Len(ty) > 0, "type")
    tp := punkt.TypeNoPeriod(t)
    testing.AssertTrue(str.Len(tp) > 0, "typeNoPeriod")
    tsp := punkt.TypeNoSentPeriod(t)
    testing.AssertTrue(str.Len(tsp) > 0, "typeNoSentPeriod")
    _ = st
}

// TestAnnotateOrtho covers Annotate + OrthoHeuristic on stored tokens.
pub fn TestAnnotateOrtho() {
    st := punkt.NewStorage()
    toks := punkt.WordTokenize("Dr. Smith went home.", false)
    punkt.Annotate(&st, toks)
    h := punkt.OrthoHeuristic(&st, toks[0])
    testing.AssertTrue(h >= -1 && h <= 1, "ortho bounded")
}

// TestMiniRegex covers MatchAt + DebugDescribe on a compiled pattern.
pub fn TestMiniRegex() {
    p, ok := mini.New("[0-9]+")
    testing.AssertTrue(ok, "compile")
    at := mini.MatchAt(&p, "abc123", 3)
    testing.AssertTrue(at >= 0, "match found")
    d := mini.DebugDescribe(&p)
    testing.AssertTrue(str.Len(d) > 0, "describe")
}

// TestMaxentWeights covers Weight/ExtraWeight miss paths on an empty
// model plus Unmarshal's truncated-input error.
pub fn TestMaxentWeights() {
    var m maxent.Model
    _, ok := maxent.Weight(&m, "k")
    testing.AssertFalse(ok, "weight miss")
    _, ok2 := maxent.ExtraWeight(&m, 0)
    testing.AssertFalse(ok2, "extra weight out of range")
    _, uerr := maxent.Unmarshal("abc", 3)
    testing.AssertTrue(str.Len(uerr.message) > 0, "truncated model rejected")
}

// TestFindModelEmbedded resolves a bundled model name to a path (or
// reports empty when the models dir is absent from cwd).
pub fn TestFindModelEmbedded() {
    p := modelpath.FindModelEmbedded("tag/en.bin")
    _ = p
    testing.AssertTrue(true, "embedded lookup did not crash")
}

// TestOptsConstructors covers FromFileOpts/FromBytesOpts/WithTokenizer.
pub fn TestOptsConstructors() {
    o := vox.WithTokenizer(vox.DocOpts{}, tokenize.NewTokenizer())
    _ = o
    testing.AssertTrue(true, "withtokenizer callable")
}
