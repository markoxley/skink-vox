// File:    internal/maxent.skink
// Purpose: Reader for the flat maximum-entropy model format used by the
//          named-entity recognizer, ported from the reference
//          implementation's internal/maxent.
//
//          # Layout (all little-endian)
//
//              magic       [8]byte  "PROSENER"
//              version     uint32
//              cardinality uint32
//              nLabels     uint32   then per label: uint16 len + bytes
//              nKeys       uint32
//              blobLen     uint32   then blobLen bytes (feature: keys,
//                                     sorted: bytewise)
//              keyOff      (nKeys+1) x uint32
//              weights     nKeys x float32
//              nExtra      uint32   then nExtra x float32
//
//          The "extra" weights are the tail of the weight vector beyond the
//          key count: GIS correction terms, which classification does not use
//          but the probability-estimating path does. They are preserved so
//          the format is lossless.
//
//          The model buffer is binary data and may contain NUL bytes, so
//          none of the str.* helpers may be applied to it — everything here
//          works on raw byte indexing and explicit offsets.
module maxent

import "std/errors"
import "std/fs"
import "std/libc"
import "std/math"
import "std/str"

// Magic identifies a flat entity model file.
var Magic = "PROSENER"

// Version is the current format version.
var Version = 1

// Model is a flat maximum-entropy model, ready for scoring.
pub struct Model {
    cardinality: int
    labels:      []string

    data:      string // raw model bytes; binary — never pass through str.Len
    blobStart: int    // absolute byte offset of the key blob in data
    blobLen:   int
    keyOff:    []int   // nKeys+1 offsets into blob
    weights:   []float // nKeys f32 weights widened to float

    extra: []float
}

// Labels returns the model's label set, in its original order.
pub fn Labels(m: *Model) -> []string {
    return m.labels
}

// Cardinality returns the model's cardinality, used by the GIS encoding.
pub fn Cardinality(m: *Model) -> int {
    return m.cardinality
}

// NumKeys reports how many feature keys the model knows.
pub fn NumKeys(m: *Model) -> int {
    return len(m.keyOff) - 1
}

// blobCmp compares the blob slice [lo,hi) against s bytewise.
fn blobCmp(m: *Model, lo: int, hi: int, s: string) -> int {
    n := hi - lo
    sl := str.Len(s)
    lim := n
    if sl < lim {
        lim = sl
    }
    for k := 0; k < lim; k = k + 1 {
        a := m.data[m.blobStart + lo + k]
        b := s[k]
        if a < b {
            return -1
        }
        if a > b {
            return 1
        }
    }
    if n < sl {
        return -1
    }
    if n > sl {
        return 1
    }
    return 0
}

// Weight returns the weight for a feature key, and whether it was known.
pub fn Weight(m: *Model, key: string) -> (float, bool) {
    n := len(m.keyOff) - 1
    lo := 0
    hi := n
    for lo < hi {
        mid := lo + (hi - lo) / 2
        if blobCmp(m, m.keyOff[mid], m.keyOff[mid + 1], key) >= 0 {
            hi = mid
        } else {
            lo = mid + 1
        }
    }
    if lo < n && blobCmp(m, m.keyOff[lo], m.keyOff[lo + 1], key) == 0 {
        return m.weights[lo], true
    }
    return 0.0, false
}

// ExtraWeight returns the i'th GIS correction weight.
pub fn ExtraWeight(m: *Model, i: int) -> (float, bool) {
    if i < 0 || i >= len(m.extra) {
        return 0.0, false
    }
    return m.extra[i], true
}

// --- decoding ---------------------------------------------------------------

// f32FromBits widens an IEEE-754 binary32 value to a float.
fn f32FromBits(bits: int) -> float {
    sign := 1.0
    if ((bits >> 31) & 1) != 0 {
        sign = -1.0
    }
    exp := (bits >> 23) & 255
    mant := bits & 8388607
    if exp == 255 {
        return sign * (1.0 / 0.0)
    }
    if exp == 0 {
        return sign * float(mant) * math.Pow(2.0, -149.0)
    }
    return sign * (1.0 + float(mant) / 8388608.0) * math.Pow(2.0, float(exp - 127))
}

fn ru8(data: string, pos: int) -> int {
    return data[pos]
}

fn ru16(data: string, pos: int) -> int {
    return data[pos] | (data[pos + 1] << 8)
}

fn ru32(data: string, pos: int) -> int {
    return data[pos] | (data[pos + 1] << 8) | (data[pos + 2] << 16) |
        (data[pos + 3] << 24)
}

// rawSlice extracts data[lo:hi] as a clean NUL-terminated string.
fn rawSlice(data: string, lo: int, hi: int) -> string {
    n := hi - lo
    buf := libc.malloc(n + 1)
    if n > 0 {
        libc.memcpy(buf, string(int64(data) + int64(lo)), n)
    }
    buf[n] = 0
    return buf
}

// lessBlob compares two blob slices bytewise.
fn lessBlob(m: *Model, aLo: int, aHi: int, bLo: int, bHi: int) -> bool {
    an := aHi - aLo
    bn := bHi - bLo
    lim := an
    if bn < lim {
        lim = bn
    }
    for k := 0; k < lim; k = k + 1 {
        a := m.data[m.blobStart + aLo + k]
        b := m.data[m.blobStart + bLo + k]
        if a < b {
            return true
        }
        if a > b {
            return false
        }
    }
    return an < bn
}

// Unmarshal decodes a flat entity model from its raw bytes.
pub fn Unmarshal(data: string, size: int) -> (Model, errors.Error) {
    var m Model
    pos := 0

    if size < 12 {
        return m, errors.New("truncated model")
    }
    magic := rawSlice(data, 0, 8)
    if magic != "PROSENER" {
        return m, errors.New("not a prose flat entity model")
    }
    pos = pos + 8

    v := ru32(data, pos)
    pos = pos + 4
    if v != 1 {
        return m, errors.New("unsupported model version")
    }

    m.cardinality = ru32(data, pos)
    pos = pos + 4

    nLabels := ru32(data, pos)
    pos = pos + 4
    labels := []string{}
    for i := 0; i < nLabels; i = i + 1 {
        n := ru16(data, pos)
        pos = pos + 2
        labels = append(labels, rawSlice(data, pos, pos + n))
        pos = pos + n
    }
    m.labels = labels

    nKeys := ru32(data, pos)
    pos = pos + 4
    blobLen := ru32(data, pos)
    pos = pos + 4

    m.data = data
    m.blobStart = pos
    m.blobLen = blobLen
    pos = pos + blobLen

    keyOff := []int{}
    for i := 0; i < nKeys + 1; i = i + 1 {
        keyOff = append(keyOff, ru32(data, pos))
        pos = pos + 4
    }
    m.keyOff = keyOff

    weights := []float{}
    for i := 0; i < nKeys; i = i + 1 {
        weights = append(weights, f32FromBits(ru32(data, pos)))
        pos = pos + 4
    }
    m.weights = weights

    nExtra := ru32(data, pos)
    pos = pos + 4
    extra := []float{}
    for i := 0; i < nExtra; i = i + 1 {
        extra = append(extra, f32FromBits(ru32(data, pos)))
        pos = pos + 4
    }
    m.extra = extra

    if pos > size {
        return m, errors.New("truncated model")
    }
    err := validate(m)
    if err.message != "" {
        return m, err
    }
    return m, errors.None()
}

// validate checks the invariants Weight relies on, so a corrupt model fails
// at load rather than mid-classification.
fn validate(m: Model) -> errors.Error {
    n := len(m.keyOff) - 1
    if len(m.weights) != n {
        return errors.New("key count and weight count disagree")
    }
    if n > 0 && m.keyOff[n] != m.blobLen {
        return errors.New("key offsets do not end at the blob length")
    }
    // Binary search is only correct on sorted input.
    for i := 1; i < n; i = i + 1 {
        if !lessBlob(&m, m.keyOff[i - 1], m.keyOff[i], m.keyOff[i], m.keyOff[i + 1]) {
            return errors.New("keys not sorted")
        }
    }
    return errors.None()
}

// Load reads and decodes a flat entity model from a file.
pub fn Load(path: string) -> (Model, errors.Error) {
    var m Model
    if !fs.IsFile(path) {
        return m, errors.New(str.Concat("model file not found: ", path))
    }
    data, err := fs.ReadAll(path)
    if err.message != "" {
        return m, err
    }
    size := int(fs.FileSize(path))
    return Unmarshal(data, size)
}
