// File:    internal/wordlist.skink
// Purpose: Ogden's Basic English word list, used as a feature by the entity
//          recognizer. It is a set rather than a slice: the lookup is one of
//          the recognizer's per-token features, so a linear scan would cost
//          850 string comparisons per token.
//
//          Uses a builtin map, not std/hashmap — generic HashMap<K,V>
//          lookups hash erased i8* keys through a mapped-memory heuristic
//          that has been observed to misclassify string literals
//          depending on module import layout (comp_error.md), making
//          membership tests nondeterministic across binaries.
module wordlist

import "internal/wordlist_data"

// Raw byte accessors for binary buffers — string indexing is
// bounds-checked against strlen, which truncates at the first NUL byte.
extern fn Skink_mem_byte(ptr: string, idx: int64) -> int
extern fn Skink_mem_write_byte(ptr: string, idx: int64, val: int)


var basic = make(map[string]bool)
var loaded = false

// ensure builds the set on first use.
fn ensure() {
    if loaded {
        return
    }
    for i := 0; i < len(wordlist_data.Words); i = i + 1 {
        basic[wordlist_data.Words[i]] = true
    }
    loaded = true
}

// IsBasic reports whether word is in Ogden's Basic English list.
pub fn IsBasic(word: string) -> bool {
    ensure()
    _, ok := basic[word]
    return ok
}

// Len returns the number of words in the list.
pub fn Len() -> int {
    return len(wordlist_data.Words)
}
