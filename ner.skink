// File:    ner.skink
// Purpose: Named-entity recognition — a port of the reference
//          implementation's ner package: a binary maximum-entropy
//          classifier over tagged tokens, plus IOB chunking that recovers
//          exact source spans.
//
//          The model ships as a binary file (models/ner/en.bin) baked into
//          the binary by the embed directive below and resolved at load
//          time by internal/modelpath.
module ner

embed "models"

import "internal/maxent"
import "internal/modelpath"
import "internal/strutil"
import "internal/unicode"
import "internal/wordlist"
import "token"

// Token is token.Token, re-exported so callers using only this
// module do not have to import token themselves.
pub type Token = token.Token
import "std/errors"
import "std/fs"
import "std/libc"
import "std/str"

// Entity is a named entity found in text.
//
// Like token.Token, it carries its position, and the same invariant holds:
//
//	src[e.Start:e.End()] == e.Text
pub struct Entity {
    // Text is the entity's content, verbatim from the source.
    Text: string

    // Label is the entity type, such as "PERSON" or "GPE".
    Label: string

    // Start is the byte offset of Text within the source.
    Start: int

    // End returns the byte offset just past this entity in the source.
    pub fn End(e: Entity) -> int {
        return e.Start + str.Len(e.Text)
    }

    // In returns the entity's text as located in src, or "" if the offsets
    // do not fit. For any entity prose produces, e.In(src) == e.Text.
    pub fn In(e: Entity, src: string) -> string {
        if e.Start < 0 || e.End() > str.Len(src) {
            return ""
        }
        return str.Substr(src, e.Start, str.Len(e.Text))
    }
}

// featureOrder is the model's fixed feature list; iteration order is part of
// the wire format since keys are name-value-label triples.
fn featureOrder() -> []string {
    return []string{
        "bias", "en-wordlist", "nextpos", "nextword", "pos", "pos+prevtag",
        "prefix3", "prevpos", "prevtag", "prevword", "shape", "shape+prevtag",
        "suffix3", "word", "word+nextpos", "word.lower", "wordlen",
    }
}

// Extracter labels tokens and groups them into entities.
pub struct Extracter {
    model: maxent.Model

    // Label assigns an IOB entity label to each token, in place.
    //
    // Tokens must already carry part-of-speech tags; the classifier uses them as
    // features.
    pub fn Label(e: *Extracter, tokens: []token.Token) {
        if len(tokens) == 0 {
            return
        }

        var history []string
        labels := maxent.Labels(&e.model)
        nLabels := len(labels)

        for i := 0; i < len(tokens); i = i + 1 {
            feats := extract(i, tokens, history)

            best := 0
            bestScore := -1.0e308 * 1.0e308
            order := featureOrder()
            for j := 0; j < nLabels; j = j + 1 {
                total := 0.0
                for k := 0; k < len(order); k = k + 1 {
                    name := order[k]
                    val, ok := feats[name]
                    if !ok {
                        val = ""
                    }
                    key := str.Concat(name, str.Concat("-", str.Concat(val, str.Concat("-", labels[j]))))
                    w, found := maxent.Weight(&e.model, key)
                    if found {
                        total = total + w
                    }
                }
                if total > bestScore {
                    bestScore = total
                    best = j
                }
            }

            tokens[i].Label = labels[best]
            history = append(history, simplePOS(labels[best]))
        }
    }

    // Chunk groups labeled tokens into entities.
    //
    // src is the text the tokens came from; it is used to recover each entity's
    // exact span. Tokens must already be labeled by Label.
    //
    // Grouping extends an entity across matching part-of-speech tags and CD
    // (numeral) runs, which is not what a textbook IOB chunker would do but is
    // what the model was trained to produce.
    pub fn Chunk(e: *Extracter, src: string, tokens: []token.Token) -> []Entity {
        var entities []Entity
        var parts []token.Token
        endLabel := ""
        idx := 0

        for i := 0; i < len(tokens); i = i + 1 {
            tok := tokens[i]
            label := tok.Label
            if (label != "O" && label != endLabel) ||
                (idx > 0 && tok.Tag == parts[idx - 1].Tag) ||
                (idx > 0 && tok.Tag == "CD" && parts[idx - 1].Label != "O") {
                endLabel = replaceFirst(label, "B", "I")
                parts = append(parts, tok)
                idx = idx + 1
            } else if (label == "O" && endLabel != "") || label == endLabel {
                // We have found the endLabel of an entity.
                if label != "O" {
                    parts = append(parts, tok)
                }
                entities = append(entities, coalesce(src, parts))

                endLabel = ""
                parts = []token.Token{}
                idx = 0
            }
        }

        return entities
    }
}

var defaultModel maxent.Model
var modelLoaded = false
var modelErr = ""

// loadModel loads the bundled English entity model exactly once.
fn loadModel() {
    if modelLoaded {
        return
    }
    modelLoaded = true
    path := modelpath.FindModel("ner/en.bin")
    if path == "" {
        modelErr = "cannot locate ner/en.bin; set SKINK_VOX_MODELS"
        return
    }
    size := int(fs.FileSize(path))
    f, err := fs.Open(path, "rb")
    if err.message != "" {
        modelErr = err.message
        return
    }
    buf := libc.malloc(size)
    n := f.Read(buf, size)
    f.Close()
    if n != size {
        modelErr = str.Concat("short read on model file: ", path)
        return
    }
    m, err2 := maxent.Unmarshal(buf, size)
    if err2.message != "" {
        modelErr = err2.message
        return
    }
    defaultModel = m
}

// New returns an Extracter backed by the bundled English model.
//
// The model is loaded on the first call and shared thereafter, so calling
// New repeatedly is cheap.
pub fn New() -> (Extracter, errors.Error) {
    loadModel()
    if modelErr != "" {
        var e Extracter
        return e, errors.New(modelErr)
    }
    return Extracter{model: defaultModel}, errors.None()
}

// FromFile returns an Extracter backed by a model file on disk.
pub fn FromFile(path: string) -> (Extracter, errors.Error) {
    if !fs.IsFile(path) {
        var e Extracter
        return e, errors.New(str.Concat("model file not found: ", path))
    }
    size := int(fs.FileSize(path))
    f, err := fs.Open(path, "rb")
    if err.message != "" {
        var e Extracter
        return e, err
    }
    buf := libc.malloc(size)
    n := f.Read(buf, size)
    f.Close()
    if n != size {
        var e Extracter
        return e, errors.New(str.Concat("short read on model file: ", path))
    }
    return FromBytes(buf, size)
}

// FromBytes returns an Extracter backed by a model in the flat format.
//
// The data is retained and must not be modified afterwards.
pub fn FromBytes(data: string, size: int) -> (Extracter, errors.Error) {
    m, err := maxent.Unmarshal(data, size)
    return Extracter{model: m}, err
}

// extract fills in the model's features for token i.
fn extract(i: int, ctx: []token.Token, history: []string) -> map[string]string {
    feats := make(map[string]string)

    word := ctx[i].Text
    prevShape := "None"

    feats["bias"] = "True"
    feats["word"] = word
    feats["pos"] = ctx[i].Tag
    feats["en-wordlist"] = boolFeature(wordlist.IsBasic(word))
    feats["word.lower"] = unicode.ToLowerStr(word)
    feats["suffix3"] = nSuffix(word, 3)
    feats["prefix3"] = nPrefix(word, 3)
    feats["shape"] = shape(word)
    feats["wordlen"] = itoa(str.Len(word))

    if i == 0 {
        feats["prevtag"] = "None"
        feats["prevword"] = "None"
        feats["prevpos"] = "None"
    } else {
        feats["prevword"] = unicode.ToLowerStr(ctx[i - 1].Text)
        feats["prevpos"] = ctx[i - 1].Tag
        feats["prevtag"] = history[i - 1]
        if i > 1 {
            prevShape = shape(ctx[i - 1].Text)
        }
    }

    if i == len(ctx) - 1 {
        feats["nextword"] = "None"
        feats["nextpos"] = "None"
    } else {
        feats["nextword"] = unicode.ToLowerStr(ctx[i + 1].Text)
        feats["nextpos"] = unicode.ToLowerStr(ctx[i + 1].Tag)
    }

    feats["word+nextpos"] = str.Concat(feats["word.lower"], str.Concat("+", feats["nextpos"]))
    feats["pos+prevtag"] = str.Concat(feats["pos"], str.Concat("+", feats["prevtag"]))
    feats["shape+prevtag"] = str.Concat(prevShape, str.Concat("+", feats["prevtag"]))

    return feats
}

// parseEntities picks the entity type out of a run of labels — PERSON wins
// ties because it is hard to identify.
fn parseEntities(ents: []string) -> string {
    if strutil.StringInSlice("B-PERSON", ents) && len(ents) == 2 {
        return "PERSON"
    }
    return str.Split(ents[0], "-")[1]
}

// coalesce turns a run of tokens into one entity.
//
// The entity's text is the exact source span rather than the tokens rejoined
// with single spaces: Text must be what is actually at Start, so "New\nYork"
// in the source cannot come back as "New York".
fn coalesce(src: string, parts: []token.Token) -> Entity {
    var labels []string
    for i := 0; i < len(parts); i = i + 1 {
        labels = append(labels, parts[i].Label)
    }

    start := parts[0].Start
    last := parts[len(parts) - 1].End()
    if start < 0 || last > str.Len(src) || start > last {
        // Should not happen, but never hand back an entity whose offsets do
        // not locate its text.
        return Entity{Label: parseEntities(labels), Text: "", Start: 0}
    }

    return Entity{
        Label: parseEntities(labels),
        Text:  str.Substr(src, start, last - start),
        Start: start,
    }
}

// --- features -----------------------------------------------------------------

// shape classifies a word's casing/punctuation shape. The ordering and the
// title-casing rule are load-bearing: the model was trained on exactly these
// categories, so "NASA" reads upcase while "Jean-Luc" reads upcase too.
fn shape(word: string) -> string {
    if isNumeric(word) {
        return "number"
    }
    n := str.Len(word)
    if n == 0 {
        return "other"
    }
    r, _ := unicode.DecodeLastRune(word, n)
    if !isWordRune(r) {
        // \W+$ — ends in non-word runes.
        return "punct"
    }
    // \w+$ — ends in word runes.
    if unicode.ToLowerStr(word) == word {
        return "downcase"
    }
    // The reference deliberately uses the word-boundary title casing here;
    // the model was trained against these exact feature values.
    if unicode.TitleStr(word) == word {
        return "upcase"
    }
    return "mixedcase"
}

// isWordRune reports whether r is a regexp \w rune — ASCII [0-9A-Za-z_].
fn isWordRune(r: int) -> bool {
    return (r >= 48 && r <= 57) || (r >= 65 && r <= 90) ||
        (r >= 97 && r <= 122) || r == 95
}

// simplePOS reduces a POS tag to the history feature the model expects:
// verbs become "v", everything else keeps its first "-" component.
fn simplePOS(pos: string) -> string {
    if str.StartsWith(pos, "V") {
        return "v"
    }
    return str.Split(pos, "-")[0]
}

// boolFeature renders a bool as the model's "True"/"False" strings.
fn boolFeature(b: bool) -> string {
    if b {
        return "True"
    }
    return "False"
}

// nSuffix returns the lowercased trailing min(len,length) bytes of word.
fn nSuffix(word: string, length: int) -> string {
    n := str.Len(word)
    if n < length {
        return unicode.ToLowerStr(word)
    }
    return unicode.ToLowerStr(str.Substr(word, n - length, length))
}

// nPrefix returns the lowercased leading min(len,length) bytes of word.
fn nPrefix(word: string, length: int) -> string {
    n := str.Len(word)
    if n < length {
        return unicode.ToLowerStr(word)
    }
    return unicode.ToLowerStr(str.Substr(word, 0, length))
}

// itoa converts a small non-negative int to its decimal string.
fn itoa(n: int) -> string {
    if n == 0 {
        return "0"
    }
    var b str.Builder
    var digits []int
    for n > 0 {
        digits = append(digits, n % 10)
        n = n / 10
    }
    for i := len(digits) - 1; i >= 0; i = i - 1 {
        b.WriteByte(48 + digits[i])
    }
    return b.String()
}

// isNumeric reports whether s parses as a floating-point number under the
// same grammar the reference uses — decimal and hex floats, "inf"/"nan"
// (any case), optional sign, and digit-separating underscores. Leading or
// trailing whitespace is rejected.
fn isNumeric(s: string) -> bool {
    n := str.Len(s)
    if n == 0 {
        return false
    }
    i := 0
    if s[i] == 43 || s[i] == 45 { // '+' or '-'
        i = i + 1
        if i >= n {
            return false
        }
    }
    rest := str.Substr(s, i, n - i)
    lower := unicode.ToLowerStr(rest)
    if lower == "inf" || lower == "infinity" || lower == "nan" {
        return true
    }

    // Hex float: 0x[hexdigits][.hexdigits]p[+-]?digits — the exponent is
    // required.
    if str.Len(lower) > 2 && lower[0] == 48 && (lower[1] == 120 || lower[1] == 88) {
        j := 2
        m := str.Len(lower)
        mant := false
        for j < m && (isHexDigit(lower[j]) || lower[j] == 95 || lower[j] == 46) {
            if isHexDigit(lower[j]) {
                mant = true
            }
            j = j + 1
        }
        if !mant || j >= m || (lower[j] != 112 && lower[j] != 80) { // 'p'/'P'
            return false
        }
        j = j + 1
        if j < m && (lower[j] == 43 || lower[j] == 45) {
            j = j + 1
        }
        exp := false
        prevDigit := true
        for j < m {
            c := lower[j]
            if c >= 48 && c <= 57 {
                exp = true
                prevDigit = true
            } else if c == 95 && prevDigit && j + 1 < m && lower[j + 1] >= 48 && lower[j + 1] <= 57 {
                prevDigit = false
            } else {
                return false
            }
            j = j + 1
        }
        return exp
    }

    // Decimal: digits[.digits][e[+-]digits], with digits possibly separated
    // by single underscores.
    mant := false
    prevDigit := true
    sawDot := false
    j := 0
    m := str.Len(lower)
    for j < m {
        c := lower[j]
        if c >= 48 && c <= 57 {
            mant = true
            prevDigit = true
        } else if c == 46 && !sawDot {
            sawDot = true
            prevDigit = false
        } else if c == 95 && prevDigit && j + 1 < m && lower[j + 1] >= 48 && lower[j + 1] <= 57 {
            prevDigit = false
        } else {
            break
        }
        j = j + 1
    }
    if !mant {
        return false
    }
    if j < m {
        if lower[j] != 101 && lower[j] != 69 { // 'e'/'E'
            return false
        }
        j = j + 1
        if j < m && (lower[j] == 43 || lower[j] == 45) {
            j = j + 1
        }
        exp := false
        prevDigit = true
        for j < m {
            c := lower[j]
            if c >= 48 && c <= 57 {
                exp = true
                prevDigit = true
            } else if c == 95 && prevDigit && j + 1 < m && lower[j + 1] >= 48 && lower[j + 1] <= 57 {
                prevDigit = false
            } else {
                return false
            }
            j = j + 1
        }
        return exp
    }
    return true
}

// isHexDigit reports whether b is [0-9a-f].
fn isHexDigit(b: int) -> bool {
    return (b >= 48 && b <= 57) || (b >= 97 && b <= 102)
}

// replaceFirst replaces only the first occurrence of old — matching the
// reference's strings.Replace(s, old, new, 1).
fn replaceFirst(s: string, old: string, new: string) -> string {
    i := str.IndexOf(s, old)
    if i < 0 {
        return s
    }
    return str.Concat(str.Substr(s, 0, i), str.Concat(new, str.Substr(s, i + str.Len(old), str.Len(s) - i - str.Len(old))))
}
