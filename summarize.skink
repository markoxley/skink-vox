// ============================================================================
// Usage statistics
// ============================================================================

// --- word sets (built lazily from the generated: lists) -------------------------

var easySet hashmap.HashMap<string, int>
var easySetInit = false
var stopSet hashmap.HashMap<string, int>
var stopSetInit = false

fn easyWordSet() -> *hashmap.HashMap<string, int> {
    if !easySetInit {
        easySetInit = true
        easySet = hashmap.New<string, int>()
        for i := 0; i < len(easydata.Words); i = i + 1 {
            easySet.Put(easydata.Words[i], 1)
        }
    }
    return &easySet
}

fn stopWordSet() -> *hashmap.HashMap<string, int> {
    if !stopSetInit {
        stopSetInit = true
        stopSet = hashmap.New<string, int>()
        for i := 0; i < len(stopdata.Words); i = i + 1 {
            stopSet.Put(stopdata.Words[i], 1)
        }
    }
    return &stopSet
}

// ============================================================================
// Syllables
// ============================================================================

var cornerMap map[string]int
var cornerInit = false

fn cornerCases() -> map[string]int {
    if !cornerInit {
        cornerInit = true
        cornerMap = make(map[string]int)
        for i := 0; i < len(cornerdata.Words); i = i + 1 {
            cornerMap[cornerdata.Words[i]] = cornerdata.Counts[i]
        }
    }
    return cornerMap
}

// syllable regexes, compiled lazily.
var patVowels mini.Pattern
var patMono1 mini.Pattern
var patMono2 mini.Pattern
var patDouble1 mini.Pattern
var patDouble2 mini.Pattern
var patDouble3 mini.Pattern
var patDouble4 mini.Pattern
var patsInit = false

fn ensurePats() {
    if patsInit {
        return
    }
    patsInit = true
    // NOTE: multi-value assignment to package-level vars is silently dropped
    // by the compiler, so compile into locals first, then assign.
    pv, _ := mini.New("[aeiouy]+")
    patVowels = pv
    pm1, _ := mini.New("cia(l|$)|" +
        "tia|" +
        "cius|" +
        "cious|" +
        "[^aeiou]giu|" +
        "[aeiouy][^aeiouy]ion|" +
        "iou|" +
        "sia$|" +
        "eous$|" +
        "[oa]gue$|" +
        ".[^aeiuoycgltdb]{2,}ed$|" +
        ".ely$|" +
        "^jua|" +
        "uai|" +
        "eau|" +
        "^busi$|" +
        "([aeiouy](b|c|ch|dg|f|g|gh|gn|k|l|lch|ll|lv|m|mm|n|nc|ng|nch|nn|p|r|rc|rn|rs|rv|s|sc|sk|sl|squ|ss|th|v|y|z)ed$)|" +
        "([aeiouy](b|ch|d|f|gh|gn|k|l|lch|ll|lv|m|mm|n|nch|nn|p|r|rn|rs|rv|s|sc|sk|sl|squ|ss|st|t|th|v|y)es$)")
    patMono1 = pm1
    pm2, _ := mini.New("[aeiouy]" +
        "(b|c|ch|d|dg|f|g|gh|gn|k|l|ll|lv|m|mm|n|nc|ng|nn|p|r|rc|rn|rs|rv|s|sc|sk|sl|squ|ss|st|t|th|v|y|z)e$")
    patMono2 = pm2
    pd1, _ := mini.New("(?:[^aeiouy]ie(r|st|t)|[aeiouym]bl|eo|ism|asm|thm|dnt|uity|dea|gean|oa|ua|eings?|[aeiouy]sh?e[rsd])$")
    patDouble1 = pd1
    // NOTE: "{3}" is written out as three class copies because "{3}" inside a
    // string literal interpolates the expression "3".
    pd2, _ := mini.New("[^gq]ua[^auieo]|[aeiou][aeiou][aeiou]|^(ia|mc|coa[dglx].)")
    patDouble2 = pd2
    pd3, _ := mini.New("[^aeiou]y[ae]|[^l]lien|riet|dien|iu|io|ii|uen|real|iell|eo[^aeiou]|[aeiou]y[aeiou]")
    patDouble3 = pd3
    pd4, _ := mini.New("[^s]ia")
    patDouble4 = pd4
}

// Syllables returns the number of syllables in the string word.
//
// NOTE: This function expects a word (not raw: text) as input.
pub fn Syllables(word: string) -> int {
    ensurePats()

    // See if we can leave early.
    length := unicode.RuneCount(word)
    if length < 1 {
        return 0
    }
    if length < 3 {
        return 1
    }

    // See if this is a known cornercase.
    word = unicode.ToLowerStr(word)
    cc := cornerCases()
    syl, ok := cc[word]
    if ok {
        return syl
    }
    text, count := clean(word)

    // Count multiple vowels.
    count = count + len(mini.FindAll(&patVowels, text))

    count = count - len(mini.FindAll(&patMono1, text))
    count = count - len(mini.FindAll(&patMono2, text))

    count = count + len(mini.FindAll(&patDouble1, text))
    count = count + len(mini.FindAll(&patDouble2, text))
    count = count + len(mini.FindAll(&patDouble3, text))
    count = count + len(mini.FindAll(&patDouble4, text))

    if count < 1 {
        return 1
    }
    return count
}

// clean strips counting prefixes/suffixes, returning the remainder plus the
// extra syllables they contribute.
fn clean(word: string) -> (string, int) {
    w, prefix := clearPart(word, incrementToPrefix(), true)
    w2, suffix := clearPart(w, incrementToSuffix(), false)
    return w2, prefix + suffix
}

// clearPart applies the first group that trims the word, crediting its
// position-based syllable count.
fn clearPart(s: string, options: [][]string, isPrefix: bool) -> (string, int) {
    old := s
    pos := len(options)
    for i := 0; i < len(options); i = i + 1 {
        if isPrefix {
            s = trimAnyPrefix(s, options[i])
        } else {
            s = trimAnySuffix(s, options[i])
        }
        if s != old {
            return s, pos - i
        }
    }
    return s, 0
}

// trimAnySuffix removes the first matching suffix.
fn trimAnySuffix(word: string, suffixes: []string) -> string {
    for i := 0; i < len(suffixes); i = i + 1 {
        if str.EndsWith(word, suffixes[i]) {
            return str.Substr(word, 0, str.Len(word) - str.Len(suffixes[i]))
        }
    }
    return word
}

// trimAnyPrefix removes the first matching prefix.
fn trimAnyPrefix(word: string, prefixes: []string) -> string {
    for i := 0; i < len(prefixes); i = i + 1 {
        if str.StartsWith(word, prefixes[i]) {
            return str.Substr(word, str.Len(prefixes[i]), str.Len(word) - str.Len(prefixes[i]))
        }
    }
    return word
}

// incrementToPrefix lists the prefix groups whose removal adds syllables.
fn incrementToPrefix() -> [][]string {
    return [][]string{
        []string{
            "above", "anti", "ante", "counter", "hyper", "afore", "agri", "infra",
            "intra", "inter", "over", "semi", "ultra", "under", "extra", "dia",
            "micro", "mega", "kilo", "pico", "nano", "macro",
        },
        []string{
            "un", "fore", "ware", "none", "non", "out", "post", "sub", "pre",
            "pro", "dis", "side",
        },
    }
}

// incrementToSuffix lists the suffix groups whose removal adds syllables.
fn incrementToSuffix() -> [][]string {
    return [][]string{
        []string{"ology", "ologist", "onomy", "onomist"},
        []string{"fully", "berry", "woman", "women"},
        []string{
            "ly", "less", "some", "ful", "er", "ers", "ness", "cian", "cians",
            "ment", "ments", "ette", "ettes", "ville", "villes", "ships", "ship",
            "side", "sides", "port", "ports", "shire", "shires", "tion", "tioned",
        },
    }
}
