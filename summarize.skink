// File:    summarize.skink
// Purpose: Text statistics — a port of the reference implementation's
//          summarize package: readability scores, keyword extraction, and
//          TL;DR paragraph ranking over punkt-segmented, word-boundary-
//          tokenized text.
//
//          The syllable counter's regexes run on the mini engine (the POSIX
//          engine lacks the constructs they: use).
module summarize

import "internal/cornerdata"
import "internal/easydata"
import "internal/mathutil"
import "internal/mini"
import "internal/stopdata"
import "internal/strutil"
import "internal/unicode"
import "segment"
import "tokenize"
import "std/hashmap"
import "std/math"
import "std/str"

// Word represents a single word in a Document.
pub struct Word {
    Text:      string // the actual text
    Syllables: int    // the number of syllables
}

// Sentence represents a single sentence in a Document.
pub struct Sentence {
    Text:      string // the actual text
    Length:    int    // the number of words
    Words:     []Word // the words in this sentence
    Paragraph: int
}

// RankedParagraph is a paragraph ranked by its number of keywords.
pub struct RankedParagraph {
    Sentences: []Sentence
    Position:  int // the zero-based position within a Document
    Rank:      int
}

// Document represents a collection of text to be analyzed.
pub struct Document {
    Content:         string         // Actual text
    NumCharacters:   float          // Number of Characters
    NumComplexWords: float          // PolysylWords without common suffixes
    NumParagraphs:   float          // Number of paragraphs
    NumPolysylWords: float          // Number of words with > 2 syllables
    NumSentences:    float          // Number of sentences
    NumSyllables:    float          // Number of syllables
    NumWords:        float          // Number of words
    NumLongWords:    float          // Number of long words
    Sentences:       []Sentence     // the Document's sentences
    WordFrequency:   map[string]int // [word]frequency

    // Initialize calculates the data necessary for computing readability and
    // usage statistics.
    pub fn Initialize(d: *Document) {
        if !sentTokInit {
            sentTokInit = true
            s, _ := segment.New()
            sentenceTokenizer = s
        }
        if !wordTokInit {
            wordTokInit = true
            wordTokenizer = tokenize.NewWordBoundaryTokenizer()
        }

        d.WordFrequency = make(map[string]int)
        paragraphs := str.Split(d.Content, "\n\n")
        for i := 0; i < len(paragraphs); i = i + 1 {
            sents := sentenceTokenizer.SegmentText(paragraphs[i])
            for j := 0; j < len(sents); j = j + 1 {
                s := sents[j]
                wordCount := d.NumWords
                d.NumSentences = d.NumSentences + 1
                var words []Word
                toks := wordTokenizer.Tokenize(s)
                for k := 0; k < len(toks); k = k + 1 {
                    word := unicodeTrimSpace(toks[k])
                    if str.Len(word) == 0 {
                        continue
                    }
                    d.NumCharacters = d.NumCharacters + countChars(word)
                    d.WordFrequency[word] = d.WordFrequency[word] + 1
                    if str.Len(word) > 6 {
                        d.NumLongWords = d.NumLongWords + 1
                    }
                    syl := Syllables(word)
                    words = append(words, Word{Text: word, Syllables: syl})
                    d.NumSyllables = d.NumSyllables + float(syl)
                    if syl > 2 {
                        d.NumPolysylWords = d.NumPolysylWords + 1
                    }
                    if isComplex(word, syl) {
                        d.NumComplexWords = d.NumComplexWords + 1
                    }
                    d.NumWords = d.NumWords + 1
                }
                d.Sentences = append(d.Sentences, Sentence{
                    Text:      unicodeTrimSpace(s),
                    Length:    int(d.NumWords - wordCount),
                    Words:     words,
                    Paragraph: i,
                })
            }
            d.NumParagraphs = d.NumParagraphs + 1
        }
    }

    // Assess returns an Assessment for the Document d.
    pub fn Assess(d: *Document) -> Assessment {
        a := Assessment{
            FleschKincaid:        d.FleschKincaid(),
            ReadingEase:         d.FleschReadingEase(),
            GunningFog:          d.GunningFog(),
            SMOG:                d.SMOG(),
            DaleChall:           d.DaleChall(),
            AutomatedReadability: d.AutomatedReadability(),
            ColemanLiau:         d.ColemanLiau(),
            LIX:                 d.LIX(),
        }

        gradeScores := []float{
            a.FleschKincaid, a.AutomatedReadability, a.GunningFog, a.SMOG,
            a.ColemanLiau,
        }

        mean := mathutil.Mean(gradeScores)
        stdDev := mathutil.StdDev(gradeScores)
        if mathutil.IsNaN(mean) || mathutil.IsNaN(stdDev) {
            a.MeanGradeLevel = 0.0
            a.StdDevGradeLevel = 0.0
        } else {
            a.MeanGradeLevel = mean
            a.StdDevGradeLevel = stdDev
        }

        return a
    }

    // Summary returns a Document's n highest ranked paragraphs according to
    // keyword frequency.
    pub fn Summary(d: *Document, n: int) -> []RankedParagraph {
        var rankings []RankedParagraph
        scores := d.Keywords()
        for i := 0; i < int(d.NumParagraphs); i = i + 1 {
            p := RankedParagraph{Position: i}
            rank := 0
            size := 0
            for j := 0; j < len(d.Sentences); j = j + 1 {
                s := d.Sentences[j]
                if s.Paragraph == i {
                    size = size + s.Length
                    for k := 0; k < len(s.Words); k = k + 1 {
                        w := s.Words[k]
                        score, found := scores[w.Text]
                        if found {
                            rank = rank + score
                        }
                    }
                    p.Sentences = append(p.Sentences, s)
                }
            }
            // Favor longer paragraphs, as they tend to be more informational.
            p.Rank = rank * size
            rankings = append(rankings, p)
        }

        // Sort by rank.
        sortByRank(rankings)

        // Take the top-n paragraphs.
        size := len(rankings)
        if size > n {
            var top []RankedParagraph
            for i := size - n; i < size; i = i + 1 {
                top = append(top, rankings[i])
            }
            rankings = top
        }

        // Sort by chronological position.
        sortByIndex(rankings)
        return rankings
    }

    // FleschKincaid computes the Flesch–Kincaid grade level.
    pub fn FleschKincaid(d: *Document) -> float {
        x := 0.39 * d.NumWords / d.NumSentences
        y := 11.8 * d.NumSyllables / d.NumWords
        return x + y - 15.59
    }

    // FleschReadingEase computes the Flesch reading-ease score.
    pub fn FleschReadingEase(d: *Document) -> float {
        x := 1.015 * d.NumWords / d.NumSentences
        y := 84.6 * d.NumSyllables / d.NumWords
        return 206.835 - x - y
    }

    // GunningFog computes the Gunning Fog index score.
    pub fn GunningFog(d: *Document) -> float {
        x := d.NumWords / d.NumSentences
        y := d.NumComplexWords / d.NumWords
        return 0.4 * (x + 100.0 * y)
    }

    // LIX computes the LIX readability measure.
    pub fn LIX(d: *Document) -> float {
        return (d.NumWords / d.NumSentences) + ((d.NumLongWords * 100.0) / d.NumWords)
    }

    // SMOG computes the SMOG grade.
    pub fn SMOG(d: *Document) -> float {
        return 1.0430 * math.Sqrt(d.NumPolysylWords * 30.0 / d.NumSentences) + 3.1291
    }

    // AutomatedReadability computes the automated readability index score.
    pub fn AutomatedReadability(d: *Document) -> float {
        x := 4.71 * (d.NumCharacters / d.NumWords)
        y := 0.5 * (d.NumWords / d.NumSentences)
        return x + y - 21.43
    }

    // ColemanLiau computes the Coleman–Liau index score.
    pub fn ColemanLiau(d: *Document) -> float {
        x := 0.0588 * (d.NumCharacters / d.NumWords) * 100.0
        y := 0.296 * (d.NumSentences / d.NumWords) * 100.0
        return x - y - 15.8
    }

    // DaleChall computes the Dale–Chall score.
    pub fn DaleChall(d: *Document) -> float {
        easy := 0.0
        easySet := easyWordSet()
        for word := range d.WordFrequency {
            if easySet.Has(word) {
                easy = easy + 1.0
            }
        }
        hard := d.NumWords - easy
        x := (hard / d.NumWords) * 100.0
        y := d.NumWords / d.NumSentences
        return 0.1579 * x + 0.0496 * y
    }

    // WordDensity returns a map of each word and its density.
    pub fn WordDensity(d: *Document) -> map[string]float {
        density := make(map[string]float)
        for word := range d.WordFrequency {
            density[word] = mathutil.Round(float(d.WordFrequency[word]) / d.NumWords, 3)
        }
        return density
    }

    // Keywords returns a Document's words as map[word]count, omitting stop
    // words and normalizing case.
    pub fn Keywords(d: *Document) -> map[string]int {
        scores := make(map[string]int)
        stops := stopWordSet()
        for word := range d.WordFrequency {
            normalized := unicode.ToLowerStr(word)
            if stops.Has(normalized) {
                continue
            }
            scores[normalized] = scores[normalized] + d.WordFrequency[word]
        }
        return scores
    }

    // MeanWordLength returns the mean number of characters per word.
    pub fn MeanWordLength(d: *Document) -> float {
        return mathutil.Round(d.NumCharacters / d.NumWords, 3)
    }
}

// Assessment provides comprehensive access to a Document's metrics.
pub struct Assessment {
    // assessments returning an estimated grade level
    AutomatedReadability: float
    ColemanLiau:          float
    FleschKincaid:        float
    GunningFog:           float
    SMOG:                 float
    LIX:                  float

    // mean & standard deviation of the above estimated grade levels
    MeanGradeLevel:   float
    StdDevGradeLevel: float

    // assessments returning non-grade numerical scores
    DaleChall:   float
    ReadingEase: float
}

var sentenceTokenizer segment.Segmenter
var sentTokInit = false
var wordTokenizer tokenize.WordBoundaryTokenizer
var wordTokInit = false

// NewDocument is a Document constructor that takes a string and calculates
// the data necessary for readability and usage statistics.
pub fn NewDocument(text: string) -> Document {
    doc := Document{Content: text}
    doc.Initialize()
    return doc
}

// unicodeTrimSpace trims Unicode whitespace from both ends.
fn unicodeTrimSpace(s: string) -> string {
    n := str.Len(s)
    start := 0
    for start < n {
        r, size := unicode.DecodeRune(s, start)
        if size < 1 || !unicode.IsSpace(r) {
            break
        }
        start = start + size
    }
    end := n
    for end > start {
        r, size := unicode.DecodeLastRune(s, end)
        if size < 1 || !unicode.IsSpace(r) {
            break
        }
        end = end - size
    }
    return str.Substr(s, start, end - start)
}

// isComplex reports whether a word counts as complex: more than two
// syllables, ignoring common suffixes.
fn isComplex(word: string, syllables: int) -> bool {
    if strutil.HasAnySuffix(word, []string{"es", "ed", "ing"}) {
        syllables = syllables - 1
    }
    return syllables > 2
}

// countChars counts the letters and numbers in word.
fn countChars(word: string) -> float {
    count := 0
    n := str.Len(word)
    i := 0
    for i < n {
        r, size := unicode.DecodeRune(word, i)
        if size < 1 {
            size = 1
        }
        if unicode.IsLetter(r) || unicode.IsNumber(r) {
            count = count + 1
        }
        i = i + size
    }
    return float(count)
}

// sortByRank orders paragraphs by ascending rank. The generic sort only
// accepts pointer-sized elements, so a plain insertion sort is used — the
// reference uses an unstable sort; this one is stable, which only differs
// when ranks tie.
fn sortByRank(rs: []RankedParagraph) {
    for i := 1; i < len(rs); i = i + 1 {
        v := rs[i]
        j := i - 1
        for j >= 0 && rs[j].Rank > v.Rank {
            rs[j + 1] = rs[j]
            j = j - 1
        }
        rs[j + 1] = v
    }
}

// sortByIndex orders paragraphs by ascending position.
fn sortByIndex(rs: []RankedParagraph) {
    for i := 1; i < len(rs); i = i + 1 {
        v := rs[i]
        j := i - 1
        for j >= 0 && rs[j].Position > v.Position {
            rs[j + 1] = rs[j]
            j = j - 1
        }
        rs[j + 1] = v
    }
}

